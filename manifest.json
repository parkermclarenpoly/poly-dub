{
  "manifest_version": 3,
  "name": "Poly Dub",
  "description": "Create and copy an account-owned PolyLinks link with automatic or manually selected US routing.",
  "version": "1.7.1",
  "minimum_chrome_version": "110",
  "action": {
    "default_title": "Create Dub link"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://dub-links-nine.vercel.app/*",
    "https://polymarket.com/*",
    "https://www.polymarket.com/*",
    "https://polymarket.us/*",
    "https://www.polymarket.us/*"
  ]
}
